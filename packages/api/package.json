{
  "name": "@optiworld/api",
  "version": "0.0.0",
  "private": true,
  "description": "Express.js and TypeScript REST API.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node ../../scripts/with-root-env.mjs tsx watch src/index.ts",
    "start": "node ../../scripts/with-root-env.mjs tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/with-root-env.mjs tsx --test src/tests/**/*.test.ts"
  },
  "dependencies": {
    "@optiworld/db": "workspace:*",
    "@optiworld/shared": "workspace:*",
    "@sendgrid/mail": "^8.1.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
