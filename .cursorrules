# ── ENVIRONMENT VARIABLES ────────────────────────────────────
# These must exist in .env. Never hardcode these values.
#
# DATABASE_URL              PostgreSQL connection string
# REDIS_URL                 Redis connection string
# NEXTAUTH_SECRET           Random secret for NextAuth
# NEXTAUTH_URL              Full URL of web app
# JWT_SECRET                Secret for API JWT signing
# JWT_REFRESH_SECRET        Separate secret for refresh tokens
# AWS_ACCESS_KEY_ID         For S3 file uploads
# AWS_SECRET_ACCESS_KEY     For S3 file uploads
# AWS_S3_BUCKET             S3 bucket name
# WHATSAPP_API_TOKEN        Meta WhatsApp Business API token
# WHATSAPP_PHONE_NUMBER_ID  Meta phone number ID
# SENDGRID_API_KEY          SendGrid email API key
# SENDGRID_FROM_EMAIL       Verified sender email
# SOCKET_IO_CORS_ORIGIN     Allowed origins for Socket.io
# NEXT_PUBLIC_API_URL       Public API base URL (used in browser)
# NEXT_PUBLIC_WS_URL        Public WebSocket URL (used in browser)
# NODE_ENV                  development | staging | production


# ── PRISMA SCHEMA KEY MODELS (summary) ───────────────────────
# Organisation  id, name, type(RETAILER|WHOLESALER|LABORATORY), status, subscriptionStatus
# User          id, orgId, email, passwordHash, role, name, phone, isActive
# Customer      id, orgId, name, phone, email, creditLimit
# Invoice       id, orgId, customerId, status(PAID|CREDIT), total, isOffline, syncedAt
# InvoiceItem   id, invoiceId, inventoryBatchId, priceCode, quantity, unitPrice, salePrice
# InventoryBatch id, orgId, priceCode, prefix, productName, salePrice, stockQty, lowStockThreshold
# CatalogProduct id, orgId, name, category, listedPrice, isPriceOnRequest, availabilityStatus
# RetailerConnection id, wholesalerOrgId, retailerOrgId, status(PENDING|APPROVED|REJECTED), visibilityMode(FULL|PRICES_HIDDEN|CATALOG_HIDDEN)
# Order         id, wholesalerOrgId, retailerOrgId, connectionId, status(PENDING|CONFIRMED|DISPATCHED|DELIVERED), totalValue, lockedAt
# OrderItem     id, orderId, catalogProductId, productName, quantity, agreedPrice
# ChatThread    id, orderId
# ChatMessage   id, threadId, senderOrgId, content, messageType(TEXT|SYSTEM|CHANGE_REQUEST)
# ChangeRequest id, chatMessageId, orderId, proposedChanges(JSON), status(PENDING|ACCEPTED|DECLINED)
# LabJob        id, labOrgId, retailerOrgId, referenceNumber, prescription(JSON), status(RECEIVED|CUTTING|FITTING|QC|READY|DISPATCHED)
# Alert         id, orgId, type, title, body, isRead, relatedEntityId, relatedEntityType
# Subscription  id, orgId, planType, status, startDate, endDate, renewalDate
# AuditLog      id, orgId, userId, action, entityType, entityId, metadata(JSON)


# ── VERSION 1 SCOPE REMINDER ─────────────────────────────────
# These features are OUT OF SCOPE for v1. Never add them:
# - Barcode or QR scanning
# - AI-driven forecasting or recommendations
# - AI smart replies in chat (v2 feature — purple disabled chip only)
# - Wholesaler revenue/profit reporting
# - Wholesaler internal invoicing or billing
# - Wholesaler ledger or accounts receivable
# - Pick-list / warehouse dispatch management
# - Bilty / transporter management
# - General retailer-wholesaler messaging inbox (order-scoped only)
# - Broadcast/bulk outreach from wholesaler to retailers
# - Open consumer marketplace
# - Cross-wholesaler product discovery
# - Attendance tracking
# - Prescription calculator tool
# - iOS app (Android only in v1 — iOS dependent on budget)

