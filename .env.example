# OptiWorld environment template.
# Copy to .env and fill in secrets before running any service.
# cp .env.example .env

# --- Database (PostgreSQL 15) ---
DATABASE_URL=postgresql://optiworld:optiworld@localhost:5432/optiworld?schema=public

# --- Cache and sessions (Redis 7) ---
REDIS_URL=redis://localhost:6379

# --- Auth: web (NextAuth.js) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Auth: Super Admin portal (separate NextAuth instance) ---
ADMIN_NEXTAUTH_SECRET=
ADMIN_NEXTAUTH_URL=http://localhost:3001

# --- Auth: API and mobile (JWT) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- File storage: AWS S3 ---
# Leave blank and set the R2 variables below when using Cloudflare R2 instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# --- File storage: Cloudflare R2 (S3-compatible alternative) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- WhatsApp Business API (official Meta API) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Realtime (Socket.io) ---
SOCKET_IO_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Public URLs consumed by the browser ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Process ports ---
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

# --- Runtime ---
NODE_ENV=development
